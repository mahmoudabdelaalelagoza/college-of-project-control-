# Supabase backend values. Use the anon public key only; never put a service-role key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX). Optional; leaving empty skips loading the external script.
VITE_GTM_ID=
NEXT_PUBLIC_GTM_ID=

