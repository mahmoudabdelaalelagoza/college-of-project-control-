{
    "dependencies":  {
                         "@supabase/supabase-js":  "^2.117.2",
                         "next":  "^16.3.8",
                         "react":  "^19.1.0",
                         "react-dom":  "^19.1.0",
                         "react-router-dom":  "^7.6.3"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.30.1",
                            "@types/node":  "26.6.4",
                            "@types/react":  "^19.1.8",
                            "@types/react-dom":  "^19.1.6",
                            "@vitejs/plugin-react":  "^6.0.1",
                            "autoprefixer":  "^10.4.21",
                            "eslint":  "^9.30.1",
                            "eslint-plugin-react-hooks":  "^5.2.0",
                            "eslint-plugin-react-refresh":  "^0.4.20",
                            "globals":  "^16.3.0",
                            "jiti":  "^2.6.1",
                            "postcss":  "^8.5.6",
                            "source-map":  "^0.7.6",
                            "tailwindcss":  "^3.4.17",
                            "typescript":  "~5.8.3",
                            "typescript-eslint":  "^8.35.1",
                            "unplugin-auto-import":  "^19.3.0",
                            "vite":  "^8.0.1"
                        },
    "name":  "react",
    "private":  true,
    "scripts":  {
                    "build":  "npm run build:css \u0026\u0026 next build --webpack \u0026\u0026 node scripts/copy-next-out-to-dist.mjs",
                    "next:build":  "next build --webpack",
                    "dev":  "vite",
                    "next:dev":  "next dev --webpack",
                    "lint":  "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
                    "preview":  "vite preview",
                    "next:start":  "next start",
                    "type-check":  "tsc --noEmit --project tsconfig.app.json",
                    "sections:index":  "node scripts/generate-section-index.mjs",
                    "test:sections":  "node --test scripts/page-sections.test.mjs",
                    "test:journeys":  "node --test scripts/journeys.test.mjs",
                    "test":  "npm run test:sections \u0026\u0026 npm run test:journeys",
                    "vite:build":  "vite build",
                    "build:css":  "tailwindcss -c tailwind.config.cjs -i ./src/index.css -o ./src/index.compiled.css --minify"
                },
    "type":  "module",
    "version":  "0.0.0"
}